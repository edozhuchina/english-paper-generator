# 复制此文件为 .env 后填写真实值。.env 不会被提交，请勿外传。
# MySQL 连接
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=english_exam

# Django
DJANGO_SECRET_KEY=change-me-please
DEBUG=True

# 自助注册开关：1 允许任何人提交注册申请（需管理员在后台启用），0 完全关闭注册
ALLOW_SELF_REGISTRATION=1

# 允许访问的主机名：默认只放行本机。需要用局域网 IP 打开时在后面追加，例如
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AI 图片识别（可选，留空则该功能自动禁用，不影响其余功能）
AI_VISION_ENABLED=0
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
